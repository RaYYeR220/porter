{
  "name": "porter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx scripts/fonts.ts && next dev",
    "build": "tsx scripts/fonts.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "snapshot": "tsx --env-file=.env.local scripts/snapshot.ts",
    "embed-backfill": "tsx --env-file=.env.local scripts/embed-backfill.ts",
    "eval": "tsx --env-file=.env.local eval/run.ts",
    "eval:spam": "tsx --env-file=.env.local eval/spam.ts",
    "eval:render": "tsx scripts/render-results.ts",
    "shadow": "tsx --env-file=.env.local scripts/shadow.ts",
    "shadow:verify": "tsx --env-file=.env.local scripts/shadow-verify.ts",
    "hero-data": "tsx --env-file=.env.local scripts/hero-data.ts",
    "fonts": "tsx scripts/fonts.ts",
    "seed:ui": "tsx --env-file=.env.local scripts/seed-ui-demo.ts",
    "seed:ui:clean": "tsx --env-file=.env.local scripts/clean-ui-demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@neondatabase/serverless": "^1.2.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "decode-named-character-reference": "^1.3.0",
    "drizzle-orm": "^0.45.4",
    "geist": "1.9.2",
    "mcp-handler": "1",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "next": "^16.4.5",
    "octokit": "^5.0.5",
    "porter-guard": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tar-stream": "^3.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
